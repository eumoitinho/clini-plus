# Azure PostgreSQL
DATABASE_URL="postgresql://usuario:senha@servidor.postgres.database.azure.com:5432/cliniplus?sslmode=require"

# Azure AD B2C
AZURE_AD_B2C_TENANT_NAME=cliniplusb2c
AZURE_AD_B2C_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_AD_B2C_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_AD_B2C_PRIMARY_USER_FLOW=B2C_1_signupsignin

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=cliniplusstorage
AZURE_STORAGE_ACCOUNT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_STORAGE_CONTAINER_NAME=documentos

# Azure SignalR
AZURE_SIGNALR_CONNECTION_STRING="Endpoint=https://cliniplus.service.signalr.net;AccessKey=xxx"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=sua-chave-secreta-aqui

# Twilio Video
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pagar.me
PAGARME_API_KEY=ak_test_xxxxxxxxxxxxxxxx
PAGARME_ENCRYPTION_KEY=ek_test_xxxxxxxxxxxxxxxx
PAGARME_WEBHOOK_SECRET=whsec_xxxxxxxx

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=CLINIPLUS <noreply@cliniplus.com.br>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
